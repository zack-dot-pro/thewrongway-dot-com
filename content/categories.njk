---
layout: page.njk
title: Categories
permalink: /categories/
---
{% for name, catPosts in collections.categories %}
<section id="{{ name | slugify }}" class="archive-group">
  <h2 class="archive-group__title">{{ name }} <span class="count">({{ catPosts.length }})</span></h2>
  <ul class="widget__list">
    {% for post in catPosts %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
